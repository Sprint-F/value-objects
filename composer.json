{
    "name": "sprintf/value-objects",
    "description": "Value Objects library for bundles",
    "minimum-stability": "stable",
    "license": "LGPL-2.1-or-later",
    "authors": [
        {
            "name": "Albert Stepantsev",
            "email": "albert.stepantsev@sprintf.ru"
        }
    ],
    "homepage": "https://sprintf.ru",
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-intl": "*",
        "symfony/serializer": "^7.4||^8.0",
        "symfony/property-access": "^7.4||^8.0"
    },
    "autoload": {
        "psr-4": {
            "SprintF\\ValueObjects\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SprintF\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "codeception/codeception": "^5.3",
        "codeception/module-asserts": "^3.3",
        "friendsofphp/php-cs-fixer": "^3.90"
    }
}
